DATABASE_URL=postgres://vocal:vocal@localhost:5433/vocal
MESSAGE_MASTER_KEY=CHANGE_ME_base64_32_bytes
COOKIE_SECURE=false
# Comma-separated allowlist of browser origins permitted to open the /ws WebSocket
# (anti-CSWSH). Leave unset to default to a same-origin check against the Host header.
# In production set it to your public origin, e.g. https://vocal.example.com
APP_ORIGIN=

# LiveKit (voix) — valeurs de dev fournies par `livekit-server --dev`.
# En production, générer une vraie paire clé/secret et la garder secrète.
# LIVEKIT_URL est renvoyée telle quelle au navigateur dans la réponse /api/voice-token :
# en production elle DOIT être l'URL WebSocket publiquement joignable du serveur LiveKit
# (et en wss:// une fois TLS en place), jamais un hostname interne/Docker-only.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
